// NEO CRM — Prisma schema (SQLite)
// Domain model cloned from the reference app: login users (sales reps /
// owners), accounts, contacts, leads (deals), calendar events, activities,
// saved reports and a settings singleton (editable picklists + defaults).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#2563eb")
  // Session-30 (S30-P3): the profile-photo round-trip — the reference's
  // aCe stores the uploaded file's URL via updateMe({profile_picture}).
  // Null = never uploaded (the gray-200 initial fallback renders).
  photoUrl     String?
  role         String   @default("rep") // rep | admin
  // Session-21 (S21-P5): the email-verification funnel. A NULL
  // verificationExpiresAt means "no verification pending" — the seeded
  // demo users and every pre-session-21 account pass straight through
  // login. The code itself is stored HASHED (scrypt, auth.ts's format);
  // the plaintext rides only the server console log.
  verificationCodeHash   String?
  verificationAttempts   Int      @default(0)
  verificationExpiresAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  contacts  Contact[]
  leads     Lead[]
  events    Event[]
  activities Activity[]
}

model Account {
  id            String    @id @default(cuid())
  name          String
  industry      String?
  email         String?
  phone         String?
  website       String?
  annualRevenue Float? // in default currency units (not minor units — display app)
  employees     Int?
  tier          String    @default("B") // A | B | C
  isKey         Boolean   @default(false)
  status        String    @default("active") // active | inactive | churned
  // Session-26 (S26-P5): the reference's Account entity carries a STORED
  // health (Healthy | At Risk | Needs Attention — its detail view's
  // class-map), backend-defaulted (its New Account dialog has NO health
  // field — live-verified: 8 labels, none health). Our accounts page
  // export includes the Health column; the field rides the raw JSON the
  // same way the reference's does.
  health        String    @default("Healthy") // Healthy | At Risk | Needs Attention
  ownerId       String?
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  leads      Lead[]
  events     Event[]
  activities Activity[]

  @@index([name])
  @@index([status])
  @@index([tier])
}

model Contact {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  company       String?
  position      String?
  source        String? // RAW value: call | email | website | partner | referral (emojis are create-dialog labels only)
  // Session-28 (S28-P1): the reference's contact vocabulary — priority is
  // Key | Standard | At Risk (NOT the lead hot/warm/cold temperature), and
  // role/engagement/companySize/photoUrl are first-class fields (the inline
  // role select, the 3-bar engagement cell, the company-size stack, the
  // photo-driven avatar).
  priority      String    @default("Standard") // key | standard | at_risk — stored "Key"/"Standard"/"At Risk"
  role          String? // Decision Maker | Key Contact | Influencer | End User | Other
  engagementLevel String? // High | Medium | Low
  companySize   String? // "Small (1-50)" | "Medium (51-500)" | "Large (500+)"
  photoUrl      String?
  status        String    @default("active")
  accountId     String?
  ownerId       String?
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account   Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads     Lead[]
  events    Event[]
  activities Activity[]

  @@index([name])
  @@index([email])
  @@index([priority])
}

model Lead {
  id               String    @id @default(cuid())
  name             String
  email            String?
  phone            String?
  company          String?
  value            Float     @default(0)
  stage            String    @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  source           String?
  status           String    @default("open") // open | closed_won | closed_lost
  expectedCloseDate DateTime?
  closedAt         DateTime?
  nextFollowUp     DateTime?
  accountId        String?
  contactId        String?
  ownerId          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([stage])
  @@index([status])
  @@index([ownerId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("meeting") // meeting | call | demo | task | reminder | appointment
  status      String   @default("scheduled") // scheduled | completed | cancelled
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  location    String?
  relatedType String? // session-5: the reference's "Related To" picker (none | contact | account | opportunity | lead)
  // Session-76 (M-76c13, bundle-decoded from the reference's SAe dialog):
  // the reference's CalendarEvent carries related_to_name — the
  // conditional "Name" field renders in the Related To pair's second
  // cell when a type is chosen. Our model lacked the column entirely.
  relatedName String?
  accountId   String?
  contactId   String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([type])
}

model Activity {
  id          String    @id @default(cuid())
  type        String    @default("call") // call | email | meeting | whatsapp | task | note
  subject     String
  notes       String?
  status      String    @default("scheduled") // scheduled | completed
  priority    String    @default("normal") // high | normal | low
  dueAt       DateTime?
  completedAt DateTime?
  relatedType String? // session-5: the reference's "Related To (Type)" picker
  relatedName String? // session-5: the reference's freeform "Related To (Name)" input
  accountId   String?
  contactId   String?
  ownerId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@index([type])
  @@index([status])
}

// Session-31 (S31-P1): the reference's SECOND deal model (bundle-decoded
// from index-DZ-xbrIm.js). The reference ships a full Opportunity entity
// with NO create-edit UI (the leads "Convert to Opportunity" item is dead —
// no onClick; no New Opportunity dialog exists); its data feeds the
// dashboard, all five reports tabs, and both insights surfaces.
// accountName/owner are NAME STRINGS — the reference stores display names,
// not relations (its Top Reps card groups by the owner string; its
// insights join by account_name).
model Opportunity {
  id          String    @id @default(cuid())
  name        String
  accountName String?
  stage       String    @default("prospecting") // prospecting | qualification | proposal | negotiation | closed_won | closed_lost
  amount      Float     @default(0)
  probability Int? // 0-100 — feeds the Forecast by Probability bands + the accuracy forecast
  closeDate   DateTime?
  source      String?
  owner       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stage])
  @@index([accountName])
}

model SavedReport {
  id        String   @id @default(cuid())
  name      String
  tab       String   @default("sales") // sales | pipeline | activity | sources | health
  config    String // JSON: { period, ownerId, stage, status }
  createdAt DateTime @default(now())
}

model Setting {
  id               String   @id @default("singleton")
  contactSources   String   @default("[\"Email\",\"Phone\",\"Website\",\"Referral\",\"Event\",\"Social Media\"]")
  leadStages       String   @default("[\"new\",\"contacted\",\"qualified\",\"proposal\",\"negotiation\",\"won\",\"lost\"]")
  activityTypes    String   @default("[\"call\",\"email\",\"meeting\",\"whatsapp\",\"task\",\"note\"]")
  accountTiers     String   @default("[\"A\",\"B\",\"C\"]")
  industries       String   @default("[\"Technology\",\"Manufacturing\",\"Retail\",\"Finance\",\"Healthcare\",\"Education\",\"Logistics\",\"Energy\"]")
  defaultCurrency  String   @default("AED")
  defaultLeadStage String   @default("new")
  defaultTier      String   @default("B")
  followUpDays     Int      @default(3)
  calendarView     String   @default("month")
  firstDayOfWeek   String   @default("monday")
  updatedAt        DateTime @updatedAt
}
