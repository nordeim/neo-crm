// NEO CRM — Prisma schema (SQLite)
// Domain model cloned from the reference app: login users (sales reps /
// owners), accounts, contacts, leads (deals), calendar events, activities,
// saved reports and a settings singleton (editable picklists + defaults).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#2563eb")
  role         String   @default("rep") // rep | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  contacts  Contact[]
  leads     Lead[]
  events    Event[]
  activities Activity[]
}

model Account {
  id            String    @id @default(cuid())
  name          String
  industry      String?
  email         String?
  phone         String?
  website       String?
  annualRevenue Float? // in default currency units (not minor units — display app)
  employees     Int?
  tier          String    @default("B") // A | B | C
  isKey         Boolean   @default(false)
  status        String    @default("active") // active | inactive | churned
  ownerId       String?
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  leads      Lead[]
  events     Event[]
  activities Activity[]

  @@index([name])
  @@index([status])
  @@index([tier])
}

model Contact {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  company       String?
  position      String?
  source        String?
  priority      String    @default("warm") // hot | warm | cold
  status        String    @default("active")
  accountId     String?
  ownerId       String?
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account   Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads     Lead[]
  events    Event[]
  activities Activity[]

  @@index([name])
  @@index([email])
  @@index([priority])
}

model Lead {
  id               String    @id @default(cuid())
  name             String
  email            String?
  phone            String?
  company          String?
  value            Float     @default(0)
  stage            String    @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  source           String?
  status           String    @default("open") // open | closed_won | closed_lost
  expectedCloseDate DateTime?
  closedAt         DateTime?
  nextFollowUp     DateTime?
  accountId        String?
  contactId        String?
  ownerId          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([stage])
  @@index([status])
  @@index([ownerId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("meeting") // appointment | call | meeting | task
  status      String   @default("scheduled") // scheduled | completed | cancelled
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  location    String?
  accountId   String?
  contactId   String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([type])
}

model Activity {
  id          String    @id @default(cuid())
  type        String    @default("call") // call | email | meeting | whatsapp | task | note
  subject     String
  notes       String?
  status      String    @default("scheduled") // scheduled | completed
  priority    String    @default("normal") // high | normal | low
  dueAt       DateTime?
  completedAt DateTime?
  accountId   String?
  contactId   String?
  ownerId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@index([type])
  @@index([status])
}

model SavedReport {
  id        String   @id @default(cuid())
  name      String
  tab       String   @default("sales") // sales | pipeline | activity | sources | health
  config    String // JSON: { period, ownerId, stage, status }
  createdAt DateTime @default(now())
}

model Setting {
  id               String   @id @default("singleton")
  contactSources   String   @default("[\"Email\",\"Phone\",\"Website\",\"Referral\",\"Event\",\"Social Media\"]")
  leadStages       String   @default("[\"new\",\"contacted\",\"qualified\",\"proposal\",\"negotiation\",\"won\",\"lost\"]")
  activityTypes    String   @default("[\"call\",\"email\",\"meeting\",\"whatsapp\",\"task\",\"note\"]")
  accountTiers     String   @default("[\"A\",\"B\",\"C\"]")
  industries       String   @default("[\"Technology\",\"Manufacturing\",\"Retail\",\"Finance\",\"Healthcare\",\"Education\",\"Logistics\",\"Energy\"]")
  defaultCurrency  String   @default("AED")
  defaultLeadStage String   @default("new")
  defaultTier      String   @default("B")
  followUpDays     Int      @default(3)
  calendarView     String   @default("month")
  firstDayOfWeek   String   @default("monday")
  updatedAt        DateTime @updatedAt
}
