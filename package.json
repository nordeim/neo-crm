{
  "name": "neo-crm",
  "version": "1.0.0",
  "description": "NEO CRM — Next.js 16 + React 19 + Prisma/SQLite CRM application",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint . --max-warnings 0",
    "db:push": "bun scripts/prisma-env.ts db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "bun prisma/seed.ts",
    "db:census": "bun scripts/census.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gate": "bun run lint && bun run typecheck && bun run test && bun run build && CI=1 bun run test:e2e",
    "sweep": "bun scripts/sweep.ts",
    "probe:ref": "bun scripts/drift-probe.ts",
    "gate:full": "bun run lint && bun run typecheck && bun run test && bun run build && CI=1 bun run test:e2e && bun run sweep -- --fail-on-drift && bun run sweep -- --width 390 --height 844 --fail-on-drift && bun run sweep -- --width 768 --height 1024 --fail-on-drift && bun run sweep -- --width 1024 --height 768 --fail-on-drift"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.525.0",
    "next": "^16.3.6",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
